{
  "name": "leaflet-transparency",
  "version": "0.0.6",
  "description": "A Leaflet plugin that allows to add an opacity control",
  "main": "leaflet-transparency.js",
  "scripts": {
    "build": "esbuild leaflet-transparency.js --minify --outfile=leaflet-transparency.min.js",
    "dev": "node build/dev.js",
    "test": "npm run build && cucumber-js",
    "preversion": "node build/version.js",
    "version": "npm run build && git add -A",
    "postversion": "npm publish --access public && git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raruto/leaflet-transparency.git"
  },
  "keywords": [
    "leaflet",
    "transparency",
    "javascript",
    "basemap",
    "overlay",
    "layer",
    "opacity-control"
  ],
  "author": "Raruto",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/Raruto/leaflet-transparency/issues"
  },
  "homepage": "https://github.com/Raruto/leaflet-transparency#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1"
  },
  "peerDependencies": {
    "leaflet": "^1.9.4 || ^2.0.0-beta.3"
  }
}
